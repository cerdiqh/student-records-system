# Copy this file to .env and fill it in. .env is never uploaded to GitHub.

# --- Required for real use -------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=paste-a-long-random-string-here
DEBUG=False
# Addresses people will type to reach the system (server name, IP, domain)
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.10
# Needed when using a domain over HTTPS, e.g. https://records.example.edu.ng
CSRF_TRUSTED_ORIGINS=
# Set to True only when the site is served over HTTPS
USE_HTTPS=False

# --- Database: sqlite (default) | postgresql | mysql -----------------------
DB_ENGINE=sqlite
# DB_NAME=sars
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# --- Email for "Forgot password" (optional) --------------------------------
# Gmail example: create an App Password at https://myaccount.google.com/apppasswords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=records.office@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Records Office <records.office@gmail.com>

# --- Optional ----------------------------------------------------------------
# TIME_ZONE=Africa/Lagos
# MAX_UNITS_PER_SEMESTER=24
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
